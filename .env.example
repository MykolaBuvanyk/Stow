# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Vercel sends this secret to the maintenance cron as a Bearer token.
CRON_SECRET=replace-with-a-long-random-secret-value
